#!/bin/sh
# Lints (fixable only) and formats staged files inside a throwaway Node
# container, then restages them. Each step runs this repo's own eslint flat
# config (from eslint.config.*) and prettier config (from package.json
# "prettier"). Fails closed: unfixable lint errors or formatter failures block
# the commit instead of letting debt into history.
set -e

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

# --- Pre-flight ---------------------------------------------------------

if [ ! -f node_modules/eslint/bin/eslint.js ]; then
  echo "pre-commit: eslint is missing (run npm install); commit blocked" >&2
  exit 1
fi

if [ ! -f node_modules/prettier/bin/prettier.cjs ]; then
  echo "pre-commit: prettier is missing (run npm install); commit blocked" >&2
  exit 1
fi

# --- ADR placement check -------------------------------------------------
# Any ADR commit must first go through adr-placement skill: determine
# ownership (repo), numbering, superseded updates, and cross-host check.
# This is a hard gate — the agent must confirm all four items before commit.
adr_files=$(git diff --cached --name-only --diff-filter=ACMR | grep '^\.trae/documents/decisions/ADR-.*\.md$' || true)

if [ -n "$adr_files" ]; then
  cat >&2 <<'EOF'
=================================================================
ADR placement check — commit blocked

You staged ADR files. Before committing, run the adr-placement skill
and confirm all four items:

1. Ownership (治理的代码在哪 → ADR 在哪):
   - SPI contract (PermissionAuthorizer, ScopeResolver): newbie-modules/devbie
   - Host-specific (ProjectMember, SCOPE_RESOLVERS map): nightwatch-backend
   - Unsure → output 3-column decision table, wait for user

2. Numbering: ls .trae/documents/decisions/ | tail -1 → current max + 1

3. Superseded: does this replace an older ADR?
   Yes → update old ADR Status + add "Superseded by:" line

4. Cross-host check: does the ADR affect multiple hosts?
   Yes → Cross-host section required

After confirming, re-stage and commit.
=================================================================
EOF
  exit 1
fi

# --- Collect staged files (whole-file staging only) ----------------------
# Two NUL-delimited lists are written to temp files so we can safely pass
# paths containing spaces through docker, and avoid "set -e" being tripped
# by eslint's exit code on unfixable errors.

list_file=$(mktemp)
all_list=$(mktemp)
lint_list=$(mktemp)
trap 'rm -f "$list_file" "$all_list" "$lint_list"' EXIT

git diff --cached --name-only --diff-filter=ACMR -z > "$list_file"

set --
while IFS= read -r -d '' path; do
  case "$path" in
    *.cjs|*.css|*.js|*.json|*.jsx|*.md|*.mdx|*.mjs|*.scss|*.ts|*.tsx|*.yml|*.yaml)
      if ! git diff --quiet -- "$path"; then
        echo "pre-commit: $path has unstaged changes; stage the whole file first" >&2
        exit 1
      fi
      case "$path" in
        *.cjs|*.js|*.jsx|*.mjs|*.ts|*.tsx)
          printf '%s\0' "$path" >> "$lint_list"
          printf '%s\0' "$path" >> "$all_list"
          ;;
        *)
          printf '%s\0' "$path" >> "$all_list"
          ;;
      esac
      ;;
  esac
done < "$list_file"

if [ ! -s "$all_list" ]; then
  exit 0
fi

# --- Lint (--fix, repo eslint flat config) -------------------------------
# set +e so we can capture eslint's exit code before restaging; the global
# set -e would otherwise abort at the docker run when unfixable errors exist.

if [ -s "$lint_list" ]; then
  set +e
  docker run --rm --network none \
    -v "$repo_root":/workspace -w /workspace \
    -v "$lint_list":/tmp/lint_list:ro \
    node:24-alpine \
    sh -c 'cat /tmp/lint_list | xargs -0 node node_modules/eslint/bin/eslint.js --fix'
  lint_exit=$?
  set -e
  xargs -0 < "$lint_list" git add --
  if [ $lint_exit -ne 0 ]; then
    echo "pre-commit: lint found unfixable errors; commit blocked" >&2
    exit 1
  fi
fi

# --- Format (repo prettier config) ---------------------------------------

if ! docker run --rm --network none \
  -v "$repo_root":/workspace -w /workspace \
  -v "$all_list":/tmp/all_list:ro \
  node:24-alpine \
  sh -c '
    set -e
    spec=$(node -p "const p = require(\"./package.json\"); typeof p.prettier === \"string\" ? p.prettier : \"\"")
    if [ -n "$spec" ]; then
      node -e "require.resolve(process.argv[1])" "$spec"
    fi
    cat /tmp/all_list | xargs -0 node node_modules/prettier/bin/prettier.cjs --write
  '; then
  echo "pre-commit: formatter failed; commit blocked" >&2
  exit 1
fi

xargs -0 < "$all_list" git add --

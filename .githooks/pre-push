#!/bin/sh
# Guards the last local exit: a commit made with --no-verify still has to pass a
# whole-tree formatting check before it can be pushed, using this repo's own
# prettier binary and config.
set -e

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

if [ ! -f node_modules/prettier/bin/prettier.cjs ]; then
  echo "pre-push: prettier is missing (run npm install); push blocked" >&2
  exit 1
fi

if ! docker run --rm --network none \
  -v "$repo_root":/workspace -w /workspace \
  node:24-alpine \
  node node_modules/prettier/bin/prettier.cjs --check .; then
  echo "pre-push: formatting issues found; run npm run format" >&2
  exit 1
fi

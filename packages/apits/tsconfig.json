{
  "compilerOptions": {
    "baseUrl": "./",
    "rootDir": "./src",
    "strict": false,
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "declaration": true,
    "removeComments": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "newLine": "LF",
    "preserveSymlinks": true,
    "skipLibCheck": true,
    "lib": ["ESNext", "DOM"]
  },
  "include": ["src", "types"],
  "exclude": ["src/api", "dist", "node_modules"]
}

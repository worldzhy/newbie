# -------------------------------------------------------------------------------- #
# This file is managed by the newbie template.                                     #
# Framework-provided defaults ship with @devbie/newbie (see framework config).     #
# -------------------------------------------------------------------------------- #
# ENVIRONMENT: 'production' or 'development'
# SERVER_SERIAL_NUMBER: Related to cronjob
# --------------------------------------------------------------------------------
APP_NAME=Newbie
APP_FRONTEND_URL=http://localhost:3001
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
ENVIRONMENT=development
PORT=3000
PRISMA_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/newbie
SERVER_SERIAL_NUMBER=1

# Built-in reporters (optional); each pair is env-gated and stays a no-op
# until both variables are set.
# Module-hub self-registration (full snapshot on boot, ping every 60s)
# MODULE_HUB_ENDPOINT=
# MODULE_HUB_TOKEN=
# Dependency health snapshots (posted every 30s)
# HEALTH_ENDPOINT=
# HEALTH_TOKEN=
# Backend request monitoring (interceptor + middleware)
# BACKEND_MONITOR_ENDPOINT=
# BACKEND_MONITOR_TOKEN=

# Variables of enabled newbie modules are generated between these markers.
# Do not edit this block manually; run 'newbie install' to regenerate it.
# @@newbie-modules-start
# @@newbie-modules-end